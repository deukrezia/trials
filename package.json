{
  "name": "trials-battlemap-maker",
  "version": "0.2.0",
  "productName": "Trials",
  "main": "desktop/main.cjs",
  "author": "Lazarus",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "description": "Trials VTT Battlemap Maker",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/*.browser.mjs",
    "assets": "node scripts/catalog.mjs",
    "build:web": "node scripts/build.mjs web",
    "build:desktop-assets": "node scripts/build.mjs desktop",
    "package:desktop": "npm run build:desktop-assets && electron-forge package --platform=win32 --arch=x64",
    "make:desktop": "npm run build:desktop-assets && electron-forge make --platform=win32 --arch=x64",
    "test:desktop": "node --test tests/desktop.electron.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@fontsource/tiny5": "5.3.0",
    "@playwright/test": "^1.64.1",
    "electron": "45.2.1",
    "jspdf": "^4.2.1",
    "pngjs": "7.0.0"
  }
}
